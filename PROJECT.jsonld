{
  "@context": {
    "@vocab": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ns/"
  },
  "@type": "SoftwareApplication",
  "@id": "https://etzhayyim.com/projects/etzhayyim-project-sre",
  "name": "etzhayyim-project-sre",
  "description": "Site Reliability Engineering project - SRE toolbar extension and monitoring tools for the etzhayyim.com ecosystem.",
  "url": "https://sre.etzhayyim.com",
  "applicationCategory": "etzhayyim-project-sre",
  "etzhayyim:projectCategory": "etzhayyim-project-sre",
  "etzhayyim:status": "development",
  "etzhayyim:components": [
    {
      "@type": "SoftwareApplication",
      "name": "sre-toolbar-backend",
      "description": "Go MCP backend for SRE toolbar tools (sre_toolbar.submit_feedback, sre_toolbar.get_system_status, sre_toolbar.update_theme).",
      "etzhayyim:path": "app/",
      "etzhayyim:technology": [
        "Go",
        "MCP",
        "legacy runtime"
      ],
      "etzhayyim:port": 8080
    },
    {
      "@type": "SoftwareApplication",
      "name": "sre-toolbar-extension",
      "description": "Chrome Manifest V3 browser extension providing SRE toolbar overlay on etzhayyim.com domains.",
      "etzhayyim:path": "extension/",
      "etzhayyim:technology": [
        "Chrome Extension",
        "Svelte 5",
        "MCP",
        "Vite"
      ]
    },
    {
      "@type": "WebSite",
      "name": "sre-ui",
      "description": "Landing page at sre.etzhayyim.com for downloading the SRE toolbar extension.",
      "url": "https://sre.etzhayyim.com",
      "etzhayyim:path": "ui/",
      "etzhayyim:technology": [
        "SvelteKit",
        "SSG"
      ],
      "etzhayyim:tier": "static",
      "etzhayyim:hostname": "sre.etzhayyim.com"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "etzhayyim-project-sre Scheduler",
          "identifier": "etzhayyim-project-sre/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
